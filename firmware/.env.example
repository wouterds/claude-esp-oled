# Copy to .env and fill in. That file is gitignored: this repository is public,
# and a password committed once stays in the history even if a later commit
# takes it out.
#
# Numbered pairs rather than one delimited list, because a password is allowed
# to contain whatever a delimiter would have been. Numbering from 1, contiguous;
# the first gap ends the list.
WIFI_1_SSID=an ssid
WIFI_1_PASS=its password
